<?xml version="1.0"?>
<package format="3">
  <!--
    package.xml 用于描述 ROS 2 包的元信息与依赖关系。
    colcon、rosdep、ament 工具链都会读取这里的内容。
  -->

  <name>visual_following_car</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble visual following car for ROCK 3B + STM32 mecanum chassis.</description>

  <!-- 包维护者信息 -->
  <maintainer email="you@example.com">MyDroid Developer</maintainer>
  <license>MIT</license>

  <!-- 构建工具：当前项目使用 ament_python -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 运行时基础依赖 -->
  <depend>ament_index_python</depend>
  <depend>geometry_msgs</depend>
  <depend>joy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- 第三方运行依赖 -->
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <!-- 测试依赖 -->
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>